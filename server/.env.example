# WhatsApp 2 Backend - Environment Configuration

# Porta HTTP (Render la assegna automaticamente via process.env.PORT)
PORT=5000

# development | production
NODE_ENV=development

# Origine consentita per CORS (REST + Socket.io). In produzione: URL del frontend.
CORS_ORIGIN=*

# Timeout chiamate alle API di traduzione (ms)
TRANSLATION_TIMEOUT_MS=2500

# Directory dei dati persistenti JsonStore (default: server/data)
# Su Render con disco persistente montato in /var/data: DATA_DIR=/var/data
DATA_DIR=
